#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
LOCK="$ROOT/runtime.lock.json"
DEST="$ROOT/docs/rust"
ARCHIVE=${HARA_STUDIO_RUNTIME_ARCHIVE:-}

read_lock() {
  node -e 'const x=require(process.argv[1]); console.log(x[process.argv[2]])' "$LOCK" "$1"
}

VERSION=$(read_lock version)
EXPECTED=$(read_lock sha256)
if [ -z "$ARCHIVE" ]; then
  URL=$(read_lock url)
  ARCHIVE="$RUNNER_TEMP/hara-studio-runtime-$VERSION.tar.gz"
  curl --fail --location --retry 3 --output "$ARCHIVE" "$URL"
fi

if command -v sha256sum >/dev/null 2>&1; then
  ACTUAL=$(sha256sum "$ARCHIVE" | cut -d ' ' -f 1)
else
  ACTUAL=$(shasum -a 256 "$ARCHIVE" | cut -d ' ' -f 1)
fi
[ "$ACTUAL" = "$EXPECTED" ] || {
  echo "Studio runtime checksum mismatch: expected $EXPECTED, got $ACTUAL" >&2
  exit 1
}

STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT
tar -xzf "$ARCHIVE" -C "$STAGE"
node "$ROOT/scripts/verify-kernel-runtime.mjs" "$STAGE"

# Docs ships only the browser kernel ABI. Studio, projects, examples, host
# services, and workspace assets remain owned by playground.hara-lang.org.
rm -rf "$DEST"
mkdir -p "$DEST"
cp "$STAGE/rust/hara.wasm" "$STAGE/rust/hta.js" "$STAGE/rust/hta-worker.js" "$DEST/"
