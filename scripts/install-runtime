#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
LOCK="$ROOT/runtime.lock.json"
DEST="$ROOT/docs/rust"
ARCHIVE=${HARA_STUDIO_RUNTIME_ARCHIVE:-}

read_lock() {
  node -e 'const x=require(process.argv[1]); console.log(x[process.argv[2]])' "$LOCK" "$1"
}

verify_runtime() {
  node "$ROOT/scripts/verify-kernel-runtime.mjs" "$1"
}

verify_release_runtime() {
  node "$ROOT/scripts/verify-kernel-runtime.mjs" "$1" --release-runtime
}

VERSION=$(read_lock version)
MODE=$(read_lock mode)
EXPECTED=$(read_lock sha256)
if [ -z "$ARCHIVE" ]; then
  if [ "$MODE" = "checked-in" ]; then
    verify_runtime "$ROOT/docs"
    echo "Using checked-in Hara Studio runtime $VERSION."
    exit 0
  fi
  URL=$(read_lock url)
  TEMP_ROOT=${RUNNER_TEMP:-${TMPDIR:-/tmp}}
  ARCHIVE="$TEMP_ROOT/hara-studio-runtime-$VERSION.tar.gz"
  if ! curl --fail --location --retry 3 --retry-all-errors --output "$ARCHIVE" "$URL"; then
    echo "Pinned Studio runtime unavailable at $URL; using the checked-in docs runtime." >&2
    verify_runtime "$ROOT/docs"
    exit 0
  fi
fi

if command -v sha256sum >/dev/null 2>&1; then
  ACTUAL=$(sha256sum "$ARCHIVE" | cut -d ' ' -f 1)
else
  ACTUAL=$(shasum -a 256 "$ARCHIVE" | cut -d ' ' -f 1)
fi
[ "$ACTUAL" = "$EXPECTED" ] || {
  echo "Studio runtime checksum mismatch: expected $EXPECTED, got $ACTUAL" >&2
  exit 1
}

STAGE=$(mktemp -d)
CURRENT=
cleanup() {
  rm -rf "$STAGE" "${CURRENT:-}"
}
trap cleanup EXIT
tar -xzf "$ARCHIVE" -C "$STAGE"
verify_release_runtime "$STAGE"

# The browser filesystem bridge belongs to Docs rather than the Studio runtime
# release. Preserve it while replacing the pinned runtime as one coherent set.
CURRENT=$(mktemp -d)
mkdir -p "$CURRENT/studio/hal"
cp "$DEST/studio/hal/fs.hal" "$CURRENT/studio/hal/"

# Docs ships the browser kernel ABI and current Studio host/resource set used
# by the interactive examples. Projects, examples, and workspace assets remain
# owned by play.hara-lang.org.
rm -rf "$DEST"
mkdir -p "$DEST"
cp -R "$STAGE/rust/." "$DEST/"
cp "$CURRENT/studio/hal/fs.hal" "$DEST/studio/hal/"
verify_runtime "$ROOT/docs"
